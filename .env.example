# Database Configuration (PostgreSQL / Analytical Engine)
DB_DIALECT=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bangladesh_ecommerce
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Analytical DuckDB Persistence Path
DUCKDB_PATH=database/ecommerce.duckdb

# Logging & Environment
ENV=production
LOG_LEVEL=INFO
RANDOM_SEED=42
